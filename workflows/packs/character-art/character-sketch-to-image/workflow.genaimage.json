{
  "schema_version": 2,
  "id": "character-sketch-to-image",
  "version": "1.0.0",
  "title": "Sketch to character art",
  "workflow": "api-workflow.json",
  "description": "Paint over your own sketch. The denoise strength sets how far the result may move from the sketch.",
  "tags": ["character-art", "image-to-image"],
  "category": "image generation",
  "parameters": {
    "checkpoint": {
      "node": "4",
      "input": "ckpt_name",
      "kind": "string",
      "required": true,
      "widget": "text",
      "group": "Model",
      "description": "Exact checkpoint file name as listed by the server. There is no default: choose a checkpoint, or a checkpoint profile that lists it."
    },
    "sketch": {
      "node": "10",
      "input": "image",
      "kind": "image_upload",
      "required": true,
      "widget": "file",
      "group": "Input",
      "description": "Your sketch. Choose it explicitly; there is no default image."
    },
    "prompt": {
      "node": "6",
      "input": "text",
      "kind": "string",
      "required": true,
      "widget": "textarea",
      "group": "Prompt",
      "description": "Approved prompt describing the character and the painted look."
    },
    "negative_prompt": {
      "node": "7",
      "input": "text",
      "kind": "string",
      "required": false,
      "default": "photorealistic, photograph, glossy render, polished finish, plastic skin, text, watermark, signature, logo, frame, border",
      "widget": "textarea",
      "group": "Prompt",
      "description": "Exclusions. The default discourages photorealism, glossy rendering, and text or watermarks."
    },
    "denoise": {
      "node": "3",
      "input": "denoise",
      "kind": "number",
      "required": true,
      "default": 0.6,
      "minimum": 0,
      "maximum": 1,
      "widget": "slider",
      "step": 0.05,
      "group": "Input",
      "description": "How far the result may move from the sketch: 0 keeps the sketch, 1 ignores it."
    },
    "seed": {
      "node": "3",
      "input": "seed",
      "kind": "seed",
      "required": true,
      "default": 42,
      "widget": "number",
      "step": 1,
      "group": "Sampler",
      "advanced": true,
      "description": "Deterministic sampler seed."
    },
    "steps": {
      "node": "3",
      "input": "steps",
      "kind": "integer",
      "required": true,
      "default": 28,
      "minimum": 1,
      "maximum": 150,
      "widget": "slider",
      "step": 1,
      "group": "Sampler",
      "advanced": true
    },
    "cfg": {
      "node": "3",
      "input": "cfg",
      "kind": "number",
      "required": true,
      "default": 7.0,
      "minimum": 1,
      "maximum": 20,
      "widget": "slider",
      "step": 0.5,
      "group": "Sampler",
      "advanced": true
    },
    "sampler_name": {
      "node": "3",
      "input": "sampler_name",
      "kind": "string",
      "required": true,
      "default": "dpmpp_2m",
      "options": ["dpmpp_2m", "euler", "euler_ancestral", "dpmpp_sde"],
      "widget": "select",
      "group": "Sampler",
      "advanced": true
    },
    "scheduler": {
      "node": "3",
      "input": "scheduler",
      "kind": "string",
      "required": true,
      "default": "karras",
      "options": ["karras", "normal", "exponential"],
      "widget": "select",
      "group": "Sampler",
      "advanced": true
    },
    "filename_prefix": {
      "node": "9",
      "input": "filename_prefix",
      "kind": "string",
      "required": false,
      "default": "character-art-sketch",
      "group": "Output",
      "advanced": true
    }
  },
  "outputs": [
    {"node": "9", "kind": "image"}
  ]
}
