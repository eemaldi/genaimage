{
  "schema_version": 1,
  "id": "character-concept",
  "version": "1.0.0",
  "title": "Gate 3 character concept",
  "workflow": "../text-to-image/api-workflow.json",
  "generation_mode": "initial_concept",
  "parameters": {
    "checkpoint": {
      "node": "4",
      "input": "ckpt_name",
      "kind": "string",
      "required": true,
      "description": "ComfyUI checkpoint filename as shown by the local server."
    },
    "positive_prompt": {
      "node": "6",
      "input": "text",
      "kind": "string",
      "required": true,
      "description": "Prompt from the Gate 3-approved visual brief."
    },
    "negative_prompt": {
      "node": "7",
      "input": "text",
      "kind": "string",
      "required": false,
      "default": "blurry, low quality",
      "description": "Exclusions from the Gate 3-approved visual brief."
    },
    "seed": {
      "node": "3",
      "input": "seed",
      "kind": "seed",
      "required": true,
      "default": 42
    },
    "steps": {
      "node": "3",
      "input": "steps",
      "kind": "integer",
      "required": true,
      "default": 20,
      "minimum": 1,
      "maximum": 150
    },
    "width": {
      "node": "5",
      "input": "width",
      "kind": "integer",
      "required": true,
      "default": 1024,
      "minimum": 64,
      "maximum": 4096
    },
    "height": {
      "node": "5",
      "input": "height",
      "kind": "integer",
      "required": true,
      "default": 1024,
      "minimum": 64,
      "maximum": 4096
    },
    "filename_prefix": {
      "node": "9",
      "input": "filename_prefix",
      "kind": "string",
      "required": false,
      "default": "character-concept"
    }
  },
  "presets": {
    "concept": {
      "steps": 20,
      "width": 1024,
      "height": 1024
    }
  },
  "outputs": [
    {
      "node": "9",
      "kind": "image"
    }
  ],
  "required_gates": [
    "gate3"
  ]
}
