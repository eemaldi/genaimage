{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GenAImage workflow manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "workflow"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "pattern": "\\S"
    },
    "title": {
      "type": "string"
    },
    "workflow": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": [
        "string",
        "null"
      ]
    },
    "thumbnail": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/parameter"
      }
    },
    "presets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {}
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/output"
      }
    }
  },
  "definitions": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "input",
        "kind"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "seed",
            "image_upload"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "allowed_values": {
          "type": [
            "array",
            "null"
          ],
          "items": {}
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ]
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ]
        },
        "widget": {
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "type": [
            "number",
            "null"
          ]
        },
        "options": {
          "type": [
            "array",
            "null"
          ],
          "items": {}
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "advanced": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    }
  }
}
