# Copy to .env (git-ignored) and edit. Compose reads .env automatically.

# Accelerator. Without COMPOSE_FILE the stack runs on the CPU. For a GPU,
# uncomment exactly one of these lines.
# AMD ROCm:
# COMPOSE_FILE=compose.yaml:compose.rocm.yaml
# NVIDIA:
# COMPOSE_FILE=compose.yaml:compose.nvidia.yaml

# AMD ROCm only: numeric group IDs of the host. Find yours with
# `getent group video render`. The values below are examples.
# VIDEO_GID=39
# RENDER_GID=105

# Optional, ROCm: hide a device for ComfyUI and Ollama. Compose does not forward
# .env variables into containers by itself, so this does nothing unless your own
# override file passes it through.
# HIP_VISIBLE_DEVICES=0

# LLM models: uncomment once a model is pulled. The model names are your choice;
# GenAImage ships no default. Leave them unset rather than empty: an empty value
# locks the setting to empty.
# GENAIMAGE_LLM_TEXT_MODEL=qwen3:8b
# GENAIMAGE_LLM_VISION_MODEL=
