# Copy to .env (git-ignored) and edit. Compose reads .env automatically.

# Accelerator override files; remove this line for the CPU default.
# NVIDIA: compose.yaml:compose.nvidia.yaml
COMPOSE_FILE=compose.yaml:compose.rocm.yaml

# AMD ROCm only: numeric group IDs of the host, from `getent group video render`.
VIDEO_GID=44
RENDER_GID=992

# Optional, ROCm: hide a device for ComfyUI and Ollama (needs your own override file).
# HIP_VISIBLE_DEVICES=0

# LLM models. Leave these commented out until a model is pulled: an empty
# value locks the setting to empty.
# GENAIMAGE_LLM_TEXT_MODEL=qwen3:8b
# GENAIMAGE_LLM_VISION_MODEL=
